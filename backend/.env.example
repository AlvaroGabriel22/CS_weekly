# PostgreSQL Database Configuration
DATABASE_URL=postgresql://qwi:qwi_secret@localhost:5432/qwi_db

# Redis Configuration (for caching and Celery)
REDIS_URL=redis://localhost:6379/0

# Application Settings
APP_NAME=Quality Weekly Intelligence
APP_VERSION=0.1.0
DEBUG=false

# Security
SECRET_KEY=change-me-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "https://yourdomain.com"]

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=4096

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=qwi@yourdomain.com

# Celery Configuration (for async tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=UTC

# Performance Tuning
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600
DATABASE_POOL_PRE_PING=true

# Audit & Compliance
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_ENABLED=true
PERMISSION_CHANGE_TRACKING=true

# Feature Flags
ENABLE_AUTO_SHARE_DEPARTMENT_FILES=true
ENABLE_MANAGER_ALL_ACCESS=true
ENABLE_AUDIT_LOGGING=true
ENABLE_PERMISSION_EXPIRY=true
